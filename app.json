{
  "expo": {
    "name": "Daily Noodle",
    "slug": "daily-noodle",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailynoodle",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.dailynoodle.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E7A4B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uk.co.dailynoodle.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "dailynoodle.co.uk", "pathPrefix": "/join.html" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/mini" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/mini/" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/mini/index.html" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/doku" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/doku/" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/doku/index.html" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/sweep" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/sweep/" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/sweep/index.html" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/path" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/path/" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/path/index.html" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/link" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/link/" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/link/index.html" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/tangle" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/tangle/" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/tangle/index.html" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/borders" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/borders/" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/borders/index.html" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/reckon" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/reckon/" },
            { "scheme": "https", "host": "dailynoodle.co.uk", "path": "/reckon/index.html" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.VIBRATE"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#11131A",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-updates",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "owner": "smellyoldog",
    "extra": {
      "eas": {
        "projectId": "e45ae724-8006-40ea-87ac-45ef75ceef81"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e45ae724-8006-40ea-87ac-45ef75ceef81"
    }
  }
}
