{
  "name": "daily-noodle-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "npm run format:check && npm run lint && npm run lint:selftest && npm run typecheck && npm run test:coverage",
    "lint:selftest": "node scripts/boundaries-selftest.js",
    "vendor:site": "node scripts/vendor-site.js --site"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.19",
    "expo-constants": "58.0.13",
    "expo-dev-client": "58.0.15",
    "expo-font": "58.0.10",
    "expo-linking": "58.0.14",
    "expo-router": "58.0.26",
    "expo-splash-screen": "58.0.11",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.6",
    "expo-updates": "58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-boundaries": "5.3.1",
    "globals": "14.0.0",
    "jest": "30.2.0",
    "jest-expo": "58.0.12",
    "prettier": "3.6.2",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}
